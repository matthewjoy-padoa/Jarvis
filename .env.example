# Copier en .env (non versionné) et remplir. Tout est facultatif : sans rien, Jarvis fonctionne avec la routine
# de synchro et des lancements simulés.
#
# Secrets (NOTION_TOKEN, AIRFLOW_USER, AIRFLOW_PASSWORD) : plutôt qu'en clair, mets leur référence 1Password
# (op://<coffre>/<élément>/<champ>, « Copy Secret Reference » dans l'app 1Password). Jarvis la lit avec « op read »
# à la première demande et ne la garde qu'en mémoire. Il faut être connecté à 1Password (app ou « eval $(op signin) »
# dans le terminal qui lance Jarvis). Ce fichier est ramené à 600 s'il est lisible par d'autres.
# Jarvis refuse de démarrer si JARVIS_DATA_DIR ou JARVIS_CONFIG_DIR est dans un dépôt git sans y être ignoré.

JARVIS_MODE=demo            # demo : lancements d'agents Claude simulés ; live : réels (claude -p)
JARVIS_CONFIG_DIR=          # dossier de la configuration (clients) ; vide = ./config
JARVIS_DATA_DIR=            # dossier des données synchronisées ; vide = ./data

NOTION_TOKEN=               # jeton d'une intégration Notion interne (ou op://…) : active « Rafraîchir depuis Notion »

AIRFLOW_BASE_URL=           # API REST v1 de l'Airflow de l'orchestrator, ex. http://localhost:8081 ; vide = lancements simulés
AIRFLOW_USER=               # en clair ou op://…
AIRFLOW_PASSWORD=           # en clair ou op://…

ORCHESTRATOR_DIR=           # clone local de integration-orchestrator (agents Claude), ex. ~/integration-orchestrator

# Agents Claude (JARVIS_MODE=live). Chaque agent a son worktree, créé depuis origin/main : le clone n'est jamais modifié.
CLAUDE_BIN=                 # chemin du binaire claude ; vide = « claude » dans le PATH
JARVIS_AGENT_ADD_DIRS=      # dossiers lisibles par l'agent en plus de son worktree, séparés par « : » (ex. ~/Documents/Claude_vault)
JARVIS_WORKTREES_DIR=       # vide = <ORCHESTRATOR_DIR>/.claude/worktrees/jarvis (ignoré par git)
JARVIS_AGENT_MAX=2          # agents simultanés au plus
JARVIS_AGENT_TIMEOUT_MIN=90 # au-delà, l'agent est interrompu
JARVIS_AGENT_MODEL=         # vide = modèle par défaut de Claude Code
JARVIS_AGENT_PERMISSION_MODE=acceptEdits
JARVIS_AGENT_ALLOWED_TOOLS= # vide = liste par défaut (lire, modifier, uv run, git, gh pr create) ; sinon séparés par « ; »
