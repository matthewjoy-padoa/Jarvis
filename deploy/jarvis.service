# Service systemd utilisateur : cp deploy/jarvis.service ~/.config/systemd/user/ && systemctl --user enable --now jarvis
# Pour qu'il tourne sans session ouverte : loginctl enable-linger $USER
[Unit]
Description=Jarvis (tableau de bord des déploiements)
After=network-online.target

[Service]
WorkingDirectory=%h/Dev/Apps/Jarvis
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/uv run --frozen uvicorn deploy_hub.main:app --host 127.0.0.1 --port 8765
Restart=on-failure
# Arrêt du service : les agents en cours reçoivent SIGTERM avec lui (ils seront marqués « interrompu »).
KillMode=control-group

[Install]
WantedBy=default.target
